[configuration]

entry_symbol = "gzscript_library_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]

macos.debug.single.x86_64 = "res://addons/gzscript/bin/libgzscript.macos.template_debug.x86_64.framework"
macos.release.single.x86_64 = "res://addons/gzscript/bin/libgzscript.macos.template_release.x86_64.framework"
macos.debug.single.arm64 = "res://addons/gzscript/bin/libgzscript.macos.template_debug.arm64.framework"
macos.release.single.arm64 = "res://addons/gzscript/bin/libgzscript.macos.template_release.arm64.framework"
linux.debug.single.x86_64 = "res://addons/gzscript/bin/libgzscript.linux.template_debug.x86_64.so"
linux.release.single.x86_64 = "res://addons/gzscript/bin/libgzscript.linux.template_release.x86_64.so"
linux.debug.single.arm64 = "res://addons/gzscript/bin/libgzscript.linux.template_debug.arm64.so"
linux.release.single.arm64 = "res://addons/gzscript/bin/libgzscript.linux.template_release.arm64.so"
windows.debug.single.x86_64 = "res://addons/gzscript/bin/libgzscript.windows.template_debug.x86_64.dll"
windows.release.single.x86_64 = "res://addons/gzscript/bin/libgzscript.windows.template_release.x86_64.dll"
windows.debug.single.arm64 = "res://addons/gzscript/bin/libgzscript.windows.template_debug.arm64.dll"
windows.release.single.arm64 = "res://addons/gzscript/bin/libgzscript.windows.template_release.arm64.dll"
