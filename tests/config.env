# Central test configuration consumed by tests/run.sh and CI.
# Versions must stay in sync with .github/workflows/build-artifacts.yml.
GZSCRIPT_GODOT_VERSION=4.7.1
GZSCRIPT_ZIG_VERSION=0.16.0
GZSCRIPT_ZLS_VERSION=0.16.0

# Build mode for test runs (Debug or ReleaseFast).
BUILD_MODE=Debug
# Set to 1 to reuse already-built binaries instead of rebuilding.
GZSCRIPT_SKIP_BUILD=0

# Per-group Godot timeouts (seconds). A timeout reports 124, distinct from
# crashes (134 SIGABRT, 139 SIGSEGV) and assertion failures (1).
TIMEOUT_COMPILER=120
TIMEOUT_CACHE=120
TIMEOUT_CONCURRENCY=180
TIMEOUT_RUNTIME=120
TIMEOUT_LIFECYCLE=120
TIMEOUT_LSP=180
TIMEOUT_EDITOR=180
TIMEOUT_INTEGRATION=180
TIMEOUT_STRESS=1500

# Stress profile.
STRESS_ITERATIONS=100

# Re-run a failed test once and report FLAKY instead of hiding it.
# The job still exits nonzero when flakiness is observed.
GZSCRIPT_RERUN_ON_FAIL=0

# Keep temp dirs, caches, and compiled modules after failures (or always).
GZSCRIPT_KEEP_TEST_ARTIFACTS=0

# Verbose harness output (commands, PIDs, paths). Runtime lifecycle tracing
# is separate: GZSCRIPT_TRACE=1 adds Godot --verbose to test invocations.
GZSCRIPT_TEST_VERBOSE=0
GZSCRIPT_TRACE=0
